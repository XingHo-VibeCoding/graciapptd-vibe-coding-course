# ============================================================================
# 自律计划 · 本地环境变量模板（Day 23 建立）
# ----------------------------------------------------------------------------
# 用法：复制成 .env 再填真值 —— `cp .env.example .env`
#
#   ⚠️ .env 已在 .gitignore 里，**绝不会被提交**（见 scripts/check-secrets.sh 的断言）。
#   ⚠️ 本文件（.env.example）**只放占位符**，不放任何真值 —— 它会入库。
#
# 说明：本项目当前的实际密钥下发**不走 .env**，而是两条云端路径（见 DEPLOY.md §四）：
#   ① 云函数运行时 → cloudbaserc.json 的 functions[].envVariables（CLI 下发，该文件被忽略）
#   ② 前端        → 只持有公开的接口地址，**没有任何密钥**
# 所以 .env 的角色是：给将来可能出现的本地脚本（离线批处理、数据迁移）留一个统一的
# 配置入口，并确保"真值文件不入库"这条规矩在项目里始终有一个落点。
# ============================================================================

# ---- 环境标识 ----
# CloudBase 环境 ID（形如 habit-tracker-xxxxxxxxxxxx）。不是密钥，但按配置管理。
# 真值请以 `tcb env list` 的输出为准，不要从文档里照抄。
TCB_ENV=

# ---- 服务端密钥（高危）----
# 环境 API Key，service_role 角色，可绕过 RLS。
# 只在 `tcb env apikey create` 时明文返回一次；丢失只能重新创建。
# 严禁写进前端代码、严禁提交、严禁贴进聊天记录或截图。
CLOUDBASE_API_KEY=

# ---- 演示身份（临时）----
# 匿名登录接入前的兜底 uid。接匿名登录后这一项要删掉（见 api-contract.md §1.4）。
DEMO_UID=seed-demo-user
